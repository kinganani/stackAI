DJANGO_SECRET_KEY=localmatch-dev-secret-key-min-32-bytes!!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (recommandé) :
# DATABASE_URL=postgres://fraislink:fraislink@localhost:5432/fraislink
# SQLite (dev local si Postgres absent) :
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=False
DEMO_MODE=True
# Laisser vide : le proxy Vite (/api → :8000) évite les pannes CORS/cookie.
